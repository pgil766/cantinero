# =============================================================================
# Cantinero: variables de entorno (EJEMPLO)
# Copia este archivo como ".env" y cambia los valores marcados con "cambiar".
# Nunca subas el archivo .env al repositorio.
#
# ⚠️ Contraseñas: usa solo letras y números. Las de la BD van dentro de una URL
#    (DATABASE_URL), donde @ % / # : rompen el formato.
# =============================================================================

# --- Infraestructura (docker-compose) ----------------------------------------
# Superusuario de Postgres: solo lo usan el init y las tareas de administración (nunca el backend).
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=cambiar-password-superusuario
# BD y rol SIN privilegios de la aplicación (lo crea db/init/01-init.sh)
APP_DB_NAME=cantinero
APP_DB_USER=cantinero_app
APP_DB_PASSWORD=cambiar-password-app
# BD y rol de Keycloak
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=cambiar-password-keycloak-db
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=cambiar-password-admin-keycloak
KC_HTTP_RELATIVE_PATH=/auth

# Solo producción (VM de Azure, Fase 8): dominio público para Caddy y URL pública de Keycloak
PUBLIC_DOMAIN=cantinero.eastus.cloudapp.azure.com
KC_HOSTNAME=https://cantinero.eastus.cloudapp.azure.com/auth

# --- Backend ----------------------------------------------------------------
# Obligatoria: development | production | test. En producción oculta /docs y /openapi.json.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Backend nativo en Windows → 127.0.0.1 (NO "localhost": en Windows intenta primero IPv6 ::1, que Docker
# no publica, y cada conexión se demora 5-20 s). Dentro de Docker, compose arma su propia URL con el host "postgres".
DATABASE_URL=postgresql+psycopg://cantinero_app:cambiar-password-app@127.0.0.1:5432/cantinero

# Keycloak (se usa desde la Fase 4)
# ISSUER debe coincidir EXACTAMENTE con la URL que usa el navegador (por eso aquí sí va "localhost").
KEYCLOAK_ISSUER=http://localhost:8080/auth/realms/cantinero
# URL por la que el backend nativo descarga la JWKS (en Docker, compose usa http://keycloak:8080/auth).
KEYCLOAK_INTERNAL_URL=http://127.0.0.1:8080/auth
KEYCLOAK_REALM=cantinero
KEYCLOAK_AUDIENCE=cantinero-api

# Modelo local (se usa desde la Fase 2)
# Backend nativo → Ollama nativo. Backend en Docker → OLLAMA_BASE_URL_DOCKER (por defecto host.docker.internal).
OLLAMA_BASE_URL=http://127.0.0.1:11434
# En la VM (Ollama en Docker con --profile ollama) DESCOMENTAR:
# OLLAMA_BASE_URL_DOCKER=http://ollama:11434
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.1
# Tiempo máximo de la respuesta completa y tope de tokens (respuesta normal / JSON de los validadores)
LLM_TIMEOUT_SECONDS=120
LLM_NUM_PREDICT=512
LLM_JSON_NUM_PREDICT=128
# Segundos que Ollama mantiene los modelos cargados tras usarlos (1800 = 30 min)
OLLAMA_KEEP_ALIVE=1800

# Embeddings y RAG (se usan desde las Fases 2 y 3)
# Embeddings servidos por Ollama (Anexo D): bge-m3, multilingüe, lee fragmentos largos.
# EMBEDDING_DIM debe coincidir con VECTOR(1024) de la migración 003; scripts.migrate lo verifica.
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
# Textos por petición a Ollama al indexar y tiempo máximo por lote
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=120
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.45
CHAT_HISTORY_TURNS=6
MAX_UPLOAD_MB=20
