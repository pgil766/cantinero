# =============================================================================
# Cantinero: variables de entorno (EJEMPLO)
# Copia este archivo como ".env" y cambia los valores marcados con "cambiar".
# Nunca subas el archivo .env al repositorio.
# =============================================================================

# --- Infraestructura (docker-compose) ----------------------------------------
POSTGRES_USER=cantinero
POSTGRES_PASSWORD=cambiar-password-postgres
APP_DB_NAME=cantinero
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=cambiar-password-keycloak-db
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=cambiar-password-admin-keycloak

# --- Backend ----------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Backend nativo en Windows → 127.0.0.1 (NO "localhost": en Windows intenta primero IPv6 ::1, que Docker
# no publica, y cada conexión se demora 5-20 s). Dentro de Docker, compose lo reemplaza por el host "postgres".
DATABASE_URL=postgresql+psycopg://cantinero:cambiar-password-postgres@127.0.0.1:5432/cantinero

# Keycloak (se usa desde la Fase 4)
# ISSUER debe coincidir EXACTAMENTE con la URL que usa el navegador (por eso aquí sí va "localhost").
KEYCLOAK_ISSUER=http://localhost:8080/auth/realms/cantinero
# URL por la que el backend descarga la JWKS (IPv4 directo, mismo motivo que DATABASE_URL).
KEYCLOAK_INTERNAL_URL=http://127.0.0.1:8080/auth
KEYCLOAK_REALM=cantinero
KEYCLOAK_AUDIENCE=cantinero-api

# Modelo local (se usa desde la Fase 2)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120

# Embeddings y RAG (se usan desde las Fases 2 y 3)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.45
CHAT_HISTORY_TURNS=6
MAX_UPLOAD_MB=20
