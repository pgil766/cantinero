# Finales de línea LF en el repositorio y en la copia de trabajo: el código corre en Linux (Docker y la VM de Azure).
* text=auto eol=lf

# Scripts de Windows con CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.docx binary
*.mp3 binary
*.mp4 binary
